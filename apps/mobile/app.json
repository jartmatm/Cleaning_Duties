{
  "expo": {
    "name": "Cleaning Duties",
    "slug": "cleaning-duties",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cleaningduties",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cleaningduties.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Cleaning Duties uses the camera to capture duty and incident evidence.",
        "NSPhotoLibraryUsageDescription": "Cleaning Duties uses your photo library to attach duty and incident evidence."
      }
    },
    "android": {
      "package": "com.cleaningduties.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cleaning Duties uses your photo library to attach duty and incident evidence.",
          "cameraPermission": "Cleaning Duties uses the camera to capture duty and incident evidence."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
